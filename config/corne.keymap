#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LM0 LM1 LM2 LM3 LM4 LB0 LB1 LB2 LB3 LB4  // Left-hand keys.
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RM0 RM1 RM2 RM3 RM4 RB0 RB1 RB2 RB3 RB4  // Right-hand keys.
#define THUMBS LH2 LH1 LH0 RH0 RH1 RH2                                      // Thumb keys.

/ {
    behaviors {
        /* Left-hand Timeless HRM */
        /* Right-hand Timeless HRM */

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <6 18 30 39 40 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
            hold-trigger-on-release;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&trans  &kp Q        &kp W            &kp E         &kp R        &kp T          &kp Y        &kp U            &kp I         &kp O        &kp P           &trans
&trans  &hml LGUI A  &hml LEFT_ALT S  &hmr LCTRL D  &mt LSHFT F  &kp G          &kp H        &hmr RSHFT F     &hmr RCTRL K  &hmr RALT L  &hmr RGUI APOS  &trans
&trans  &lt 3 Z      &kp X            &kp C         &kp V        &kp B          &kp N        &kp M            &kp COMMA     &kp DOT      &lt 3 SLASH     &trans
                                      &lt 4 ESC     &lt 1 TAB    &lt 2 SPACE    &lt 6 ENTER  &lt 5 BACKSPACE  &lt 7 DELETE
            >;
        };

        Nav {
            bindings = <
&trans    &trans        &trans     &trans          &trans  &trans    &kp C_AC_REDO   &kp C_AC_PASTE  &kp C_AC_COPY  &kp C_AC_CUT     &kp C_AC_UNDO  &trans
&kp LGUI  &kp LEFT_ALT  &kp LCTRL  &kp LEFT_SHIFT  &trans  &trans    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW   &kp RIGHT_ARROW  &caps_word     &trans
&trans    &trans        &trans     &trans          &trans  &trans    &kp INSERT      &kp PAGE_DOWN   &kp PG_UP      &kp HOME         &kp END        &trans
                                   &trans          &trans  &trans    &kp ENTER       &kp BACKSPACE   &kp DELETE
            >;
        };

        Mouse {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans  &trans    &trans        &trans     &trans      &trans    &kp C_AC_REDO   &kp C_AC_PASTE  &kp C_AC_COPY  &kp C_AC_CUT     &kp C_AC_UNDO  &kp BSPC
&trans  &kp LGUI  &kp LEFT_ALT  &kp LCTRL  &kp LSHIFT  &trans    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP   &mmv MOVE_RIGHT  &trans         &trans
&trans  &trans    &trans        &trans     &trans      &trans    &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP   &msc SCRL_RIGHT  &trans         &trans
                                &trans     &trans      &trans    &mkp LCLK       &mkp RCLK       &mkp MCLK
            >;
        };

        Button {
            bindings = <
&trans  &trans    &trans        &trans     &trans      &trans    &kp C_AC_REDO   &kp C_AC_PASTE  &kp C_AC_COPY  &kp C_AC_CUT     &kp C_AC_UNDO  &kp BSPC
&trans  &kp LGUI  &kp LEFT_ALT  &kp LCTRL  &kp LSHIFT  &trans    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP   &mmv MOVE_RIGHT  &trans         &trans
&trans  &trans    &trans        &trans     &trans      &trans    &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP   &msc SCRL_RIGHT  &trans         &trans
                                &trans     &trans      &trans    &mkp LCLK       &mkp RCLK       &mkp MCLK
            >;
        };

        Media {
            bindings = <
&trans  &trans    &trans        &trans     &trans      &trans    &trans          &trans             &trans           &trans        &trans        &kp BSPC
&trans  &kp LGUI  &kp LEFT_ALT  &kp LCTRL  &kp LSHIFT  &trans    &kp C_PREVIOUS  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_NEXT    &bt BT_CLR    &trans
&trans  &trans    &trans        &trans     &trans      &trans    &out OUT_TOG    &bt BT_SEL 0       &bt BT_SEL 1     &bt BT_SEL 2  &bt BT_SEL 3  &trans
                                &trans     &trans      &trans    &mkp LCLK       &mkp RCLK          &mkp MCLK
            >;
        };

        Num {
            bindings = <
&trans  &kp LEFT_BRACKET  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp RIGHT_BRACKET    &trans  &trans     &trans     &trans    &trans    &trans
&trans  &kp SEMICOLON     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp EQUAL            &trans  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &trans
&trans  &kp GRAVE         &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp BACKSLASH        &trans  &trans     &trans     &trans    &trans    &trans
                                        &kp PERIOD    &kp N0        &kp MINUS            &trans  &trans     &trans
            >;
        };

        Sym {
            bindings = <
&trans  &kp LEFT_BRACE  &kp AMPERSAND  &kp ASTRK             &kp LEFT_PARENTHESIS   &kp RIGHT_BRACE    &trans  &trans     &trans     &trans    &trans    &trans
&trans  &kp COLON       &kp DOLLAR     &kp PERCENT           &kp CARET              &kp PLUS           &trans  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &trans
&trans  &kp TILDE       &kp EXCL       &kp AT                &kp HASH               &kp PIPE           &trans  &trans     &trans     &trans    &trans    &trans
                                       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDER          &trans  &trans     &trans
            >;
        };

        Fun {
            bindings = <
&trans  &kp F12  &kp F7  &kp F8             &kp F9   &kp RIGHT_BRACE    &trans  &trans     &trans     &trans    &trans    &trans
&trans  &kp F11  &kp F4  &kp F5             &kp F6   &kp PLUS           &trans  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &trans
&trans  &kp F10  &kp F1  &kp F2             &kp F3   &kp PIPE           &trans  &trans     &trans     &trans    &trans    &trans
                         &kp K_APPLICATION  &kp TAB  &kp SPACE          &trans  &trans     &trans
            >;
        };
    };
};
